A = list(map(int, input("Введите числа: ").split()))
odd_reversed = A[1::2][::-1]
result = A[::2]
merged = []
for i in range(len(odd_reversed)):
    merged.append(result[i])
    merged.append(odd_reversed[i])
if len(result) > len(odd_reversed):
    merged.append(result[-1])
print(merged)

