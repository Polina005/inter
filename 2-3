#4
grades = list(map(int, input("Введите оценки: ").split()))
filtered = []
i = 0
while i < len(grades):
    if grades[i] == 2 and i + 1 < len(grades) and grades[i+1] != 2:
        i += 1
    else:
        filtered.append(grades[i])
        i += 1
avg = sum(filtered) / len(filtered)
result = int(avg)
print(result)

#5
A = list(map(int, input("Введите числа: ").split()))

n = len(A)
mid_index = n // 2
median = None
for x in A:
    less_count = 0
    for y in A:
        if y < x:
            less_count += 1
    if less_count == mid_index:
        median = x
        break

print("Медиана:", median)

