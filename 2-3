#9
A = list(map(int, input("Введите числа: ").split()))
k = int(input("Введите длину подпоследовательности: "))
current_sum = sum(A[:k])
max_sum = current_sum
for i in range(k, len(A)):
    current_sum += A[i] - A[i - k]
    if current_sum > max_sum:
        max_sum = current_sum
print("Наибольшая сумма:", max_sum)
